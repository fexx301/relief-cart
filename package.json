{
  "name": "relief-cart",
  "version": "0.1.0",
  "private": true,
  "description": "Policy-aware lost-luggage recovery agent with a bounded sandbox checkout and claim pack",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cleanverse:validator": "node --env-file=.env scripts/cleanverse-validator.mjs",
    "cleanverse:preflight": "node --env-file=.env scripts/cleanverse-preflight.mjs",
    "cleanverse:deploy": "node --env-file=.env scripts/cleanverse-deploy.mjs",
    "cleanverse:grant": "node --env-file=.env scripts/cleanverse-grant.mjs",
    "cleanverse:apass": "node --env-file=.env scripts/cleanverse-apass-preflight.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "nanoid": "^5.1.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.15",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
